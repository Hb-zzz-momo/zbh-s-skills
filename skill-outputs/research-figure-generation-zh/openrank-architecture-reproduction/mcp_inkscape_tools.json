[
  {
    "name": "action_list",
    "description": "List available Inkscape actions.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "action_run",
    "description": "Run Inkscape actions on a document.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "enum": [
            "file",
            "inline"
          ],
          "type": "string"
        },
        "doc_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export_type": {
          "default": null,
          "enum": [
            "png",
            "pdf",
            "svg"
          ],
          "type": "string"
        },
        "export_out": {
          "default": null,
          "type": "string"
        },
        "export_dpi": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export_area": {
          "default": "page",
          "enum": [
            "page",
            "drawing"
          ],
          "type": "string"
        },
        "timeout_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "doc_type"
      ],
      "type": "object"
    }
  },
  {
    "name": "dom_validate",
    "description": "Validate SVG document structure.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "enum": [
            "file",
            "inline"
          ],
          "type": "string"
        },
        "doc_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "doc_type"
      ],
      "type": "object"
    }
  },
  {
    "name": "dom_set",
    "description": "Set attributes/styles on DOM elements.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "enum": [
            "file",
            "inline"
          ],
          "type": "string"
        },
        "save_as": {
          "type": "string"
        },
        "doc_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ops_json": {
          "default": "[]",
          "type": "string"
        }
      },
      "required": [
        "doc_type",
        "save_as"
      ],
      "type": "object"
    }
  },
  {
    "name": "dom_clean",
    "description": "Clean SVG using scour optimizer.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "enum": [
            "file",
            "inline"
          ],
          "type": "string"
        },
        "save_as": {
          "type": "string"
        },
        "doc_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "doc_type",
        "save_as"
      ],
      "type": "object"
    }
  }
]