{
  "tools": {
    "wps_ppt_distribute_shapes": {
      "description": "等距分布幻灯片中的多个形状。\n\n支持的分布方向：\n- horizontal: 水平等距分布\n- vertical: 垂直等距分布\n\n使用场景：\n- \"让这些形状水平等距排列\"\n- \"垂直均匀分布这些元素\"",
      "maps_to": "wps_ppt_distribute_shapes",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "direction": {
            "description": "分布方向",
            "enum": [
              "horizontal",
              "vertical"
            ],
            "type": "string"
          },
          "shapeIndices": {
            "description": "要分布的形状索引数组（从1开始）",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndices",
          "direction"
        ],
        "type": "object"
      }
    }
  }
}
