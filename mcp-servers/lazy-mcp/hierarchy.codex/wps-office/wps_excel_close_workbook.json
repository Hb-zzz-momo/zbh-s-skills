{
  "tools": {
    "wps_excel_close_workbook": {
      "description": "关闭指定的Excel工作簿，可选是否保存。",
      "maps_to": "wps_excel_close_workbook",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "工作簿名称，不填则关闭当前工作簿",
            "type": "string"
          },
          "save": {
            "description": "是否保存，默认true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
