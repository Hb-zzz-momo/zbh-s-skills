{
  "tools": {
    "wps_ppt_set_table_cell": {
      "description": "设置PPT表格中指定单元格的文本内容。\n\n使用场景：\n- \"把表格第1行第2列的内容改成'销售额'\"\n- \"设置单元格文本\"\n- \"填写表格内容\"",
      "maps_to": "wps_ppt_set_table_cell",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "col": {
            "description": "列号（从1开始）",
            "type": "number"
          },
          "row": {
            "description": "行号（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          },
          "tableIndex": {
            "description": "表格索引（从1开始）",
            "type": "number"
          },
          "text": {
            "description": "要设置的文本内容",
            "type": "string"
          }
        },
        "required": [
          "slideIndex",
          "tableIndex",
          "row",
          "col",
          "text"
        ],
        "type": "object"
      }
    }
  }
}
