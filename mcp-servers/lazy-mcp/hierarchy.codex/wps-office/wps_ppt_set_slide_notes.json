      "description": "设置幻灯片的备注内容，用于演讲提示。\n\n使用场景：\n- \"给第1页添加备注\"\n- \"写一些演讲提示\"\n- \"修改备注内容\"",
      "maps_to": "wps_ppt_set_slide_notes",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "notes": {
            "description": "备注内容",
            "type": "string"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "notes"
        ],
        "type": "object"
      }
    }
  }
}
