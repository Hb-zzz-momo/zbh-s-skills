{
  "tools": {
    "wps_ppt_set_shape_transparency": {
      "description": "设置幻灯片中指定形状的透明度。\n\n使用场景：\n- \"把这个形状设为半透明\"\n- \"设置形状透明度为50%\"",
      "maps_to": "wps_ppt_set_shape_transparency",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "shapeIndex": {
            "description": "形状索引（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          },
          "transparency": {
            "description": "透明度值 (0-100)，0为完全不透明，100为完全透明",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndex",
          "transparency"
        ],
        "type": "object"
      }
    }
  }
}
