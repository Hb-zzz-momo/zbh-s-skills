{
  "tools": {
    "wps_ppt_add_textbox": {
      "description": "在幻灯片中添加文本框。\n\n使用场景：\n- \"在第1页添加一个文本框\"\n- \"插入一个写着标题的文本框\"\n- \"添加文本框并设置字号\"",
      "maps_to": "wps_ppt_add_textbox",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "fontName": {
            "description": "字体名称，如 \"微软雅黑\"",
            "type": "string"
          },
          "fontSize": {
            "description": "字号大小",
            "type": "number"
          },
          "height": {
            "description": "高度（像素），默认50",
            "type": "number"
          },
          "left": {
            "description": "左边距（像素），默认100",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始），默认1",
            "type": "number"
          },
          "text": {
            "description": "文本框内容",
            "type": "string"
          },
          "top": {
            "description": "上边距（像素），默认100",
            "type": "number"
          },
          "width": {
            "description": "宽度（像素），默认200",
            "type": "number"
          }
        },
        "type": "object"
      }
    }
  }
}
