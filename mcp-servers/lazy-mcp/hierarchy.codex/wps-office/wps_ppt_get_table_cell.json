{
  "tools": {
    "wps_ppt_get_table_cell": {
      "description": "获取PPT表格中指定单元格的文本内容。\n\n使用场景：\n- \"读取表格第1行第1列的内容\"\n- \"获取单元格文本\"\n- \"查看表格数据\"",
      "maps_to": "wps_ppt_get_table_cell",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "col": {
            "description": "列号（从1开始）",
            "type": "number"
          },
          "row": {
            "description": "行号（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          },
          "tableIndex": {
            "description": "表格索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "tableIndex",
          "row",
          "col"
        ],
        "type": "object"
      }
    }
  }
}
