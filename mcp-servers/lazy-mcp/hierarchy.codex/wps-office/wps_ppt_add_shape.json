{
  "tools": {
    "wps_ppt_add_shape": {
      "description": "在幻灯片中添加形状。\n\n支持的形状类型：\n- rectangle: 矩形\n- oval: 椭圆\n- triangle: 三角形\n- diamond: 菱形\n- pentagon: 五边形\n- hexagon: 六边形\n- arrow: 箭头\n- star: 星形\n- heart: 心形\n- cloud: 云形\n\n使用场景：\n- \"在第1页添加一个矩形\"\n- \"插入一个蓝色的圆形\"\n- \"添加一个带文字的箭头\"",
      "maps_to": "wps_ppt_add_shape",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "fillColor": {
            "description": "填充颜色，十六进制如 #FF0000",
            "type": "string"
          },
          "height": {
            "description": "高度（像素），默认100",
            "type": "number"
          },
          "left": {
            "description": "左边距（像素），默认100",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始），默认1",
            "type": "number"
          },
          "text": {
            "description": "形状内的文本",
            "type": "string"
          },
          "top": {
            "description": "上边距（像素），默认100",
            "type": "number"
          },
          "type": {
            "description": "形状类型",
            "enum": [
              "rectangle",
              "oval",
              "triangle",
              "diamond",
              "pentagon",
              "hexagon",
              "arrow",
              "star",
              "heart",
              "cloud"
            ],
            "type": "string"
          },
          "width": {
            "description": "宽度（像素），默认100",
            "type": "number"
          }
        },
        "type": "object"
      }
    }
  }
}
