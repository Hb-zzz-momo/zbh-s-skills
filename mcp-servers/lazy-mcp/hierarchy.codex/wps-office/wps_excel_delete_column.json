{
  "tools": {
    "wps_excel_delete_column": {
      "description": "删除指定列。可指定起始列号和删除列数。",
      "maps_to": "wps_excel_delete_column",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "要删除的起始列号（从1开始）",
            "type": "number"
          },
          "count": {
            "description": "要删除的列数，默认1",
            "type": "number"
          }
        },
        "required": [
          "column"
        ],
        "type": "object"
      }
    }
  }
}
