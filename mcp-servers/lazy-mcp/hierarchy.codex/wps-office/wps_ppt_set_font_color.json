{
  "tools": {
    "wps_ppt_set_font_color": {
      "description": "设置幻灯片中指定形状的文字颜色。\n\n使用场景：\n- \"把标题改成红色\"\n- \"设置第2页第1个文本框的文字颜色为蓝色\"\n- \"修改文字颜色\"",
      "maps_to": "wps_ppt_set_font_color",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "color": {
            "description": "颜色值，支持十六进制如 \"#FF0000\" 或颜色名如 \"red\"",
            "type": "string"
          },
          "shapeIndex": {
            "description": "形状索引（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndex",
          "color"
        ],
        "type": "object"
      }
    }
  }
}
