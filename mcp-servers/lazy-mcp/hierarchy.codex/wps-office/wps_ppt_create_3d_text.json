{
  "tools": {
    "wps_ppt_create_3d_text": {
      "description": "在幻灯片中创建带有3D效果的文字。\n\n可以指定文字内容和3D样式参数。\n\n使用场景：\n- \"创建3D标题文字\"\n- \"添加立体文字效果\"\n- \"做一个炫酷的3D文字\"",
      "maps_to": "wps_ppt_create_3d_text",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          },
          "style": {
            "description": "可选的3D样式参数，如 {depth:30,material:\"metal\",color:\"#FFD700\",fontSize:48,rotation:{rotX:20,rotY:30}}",
            "type": "object"
          },
          "text": {
            "description": "文字内容",
            "type": "string"
          }
        },
        "required": [
          "slideIndex",
          "text"
        ],
        "type": "object"
      }
    }
  }
}
