{
  "tools": {
    "wps_excel_hide_row": {
      "description": "隐藏或显示Excel指定行。可一次操作连续多行。",
      "maps_to": "wps_excel_hide_row",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "count": {
            "description": "连续行数，默认1",
            "type": "number"
          },
          "hide": {
            "description": "是否隐藏，true=隐藏 false=显示，默认true",
            "type": "boolean"
          },
          "row": {
            "description": "起始行号，从1开始",
            "type": "number"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          }
        },
        "required": [
          "row"
        ],
        "type": "object"
      }
    }
  }
}
