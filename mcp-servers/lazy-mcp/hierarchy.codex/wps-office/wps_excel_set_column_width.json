{
  "tools": {
    "wps_excel_set_column_width": {
      "description": "设置Excel指定列的列宽。支持单列或连续多列。",
      "maps_to": "wps_excel_set_column_width",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "列标识，如 A（单列）或 A:C（连续多列）",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          },
          "width": {
            "description": "列宽数值（字符宽度单位），如 15、20",
            "type": "number"
          }
        },
        "required": [
          "column",
          "width"
        ],
        "type": "object"
      }
    }
  }
}
