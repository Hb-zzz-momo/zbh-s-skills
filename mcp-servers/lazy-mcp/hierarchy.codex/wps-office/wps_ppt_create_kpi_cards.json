{
  "tools": {
    "wps_ppt_create_kpi_cards": {
      "description": "在幻灯片上创建KPI指标卡片。\n\n每个KPI卡片数据项包含：\n- title: 指标名称（如\"销售额\"、\"增长率\"）\n- value: 指标数值（如\"¥128万\"、\"+15.3%\"）\n- trend: 趋势方向（up/down/flat），可选\n- color: 卡片颜色（十六进制），可选\n\n使用场景：\n- \"创建一组KPI展示卡片\"\n- \"在第2页展示销售数据指标\"\n- \"添加业绩看板\"",
      "maps_to": "wps_ppt_create_kpi_cards",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "data": {
            "description": "KPI数据数组，每项包含title（指标名称）、value（指标数值）、trend（趋势:up/down/flat，可选）、color（颜色，可选）",
            "items": {
              "properties": {
                "color": {
                  "description": "卡片颜色（十六进制）",
                  "type": "string"
                },
                "title": {
                  "description": "指标名称",
                  "type": "string"
                },
                "trend": {
                  "description": "趋势方向",
                  "enum": [
                    "up",
                    "down",
                    "flat"
                  ],
                  "type": "string"
                },
                "value": {
                  "description": "指标数值",
                  "type": "string"
                }
              },
              "required": [
                "title",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "data"
        ],
        "type": "object"
      }
    }
  }
}
