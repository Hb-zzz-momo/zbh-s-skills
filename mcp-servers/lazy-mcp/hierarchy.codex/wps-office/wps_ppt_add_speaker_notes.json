{
  "tools": {
    "wps_ppt_add_speaker_notes": {
      "description": "添加或追加演讲者备注到指定幻灯片。\n\n使用场景：\n- \"给第1页添加演讲者备注\"\n- \"在备注中写上提示词\"\n- \"追加演讲提示到第3页\"",
      "maps_to": "wps_ppt_add_speaker_notes",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "notes": {
            "description": "演讲者备注内容",
            "type": "string"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "notes"
        ],
        "type": "object"
      }
    }
  }
}
