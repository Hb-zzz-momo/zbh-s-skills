{
  "tools": {
    "wps_excel_delete_cell_comment": {
      "description": "删除Excel单元格上的批注。",
      "maps_to": "wps_excel_delete_cell_comment",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "cell": {
            "description": "单元格地址，如 A1、B2",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          }
        },
        "required": [
          "cell"
        ],
        "type": "object"
      }
    }
  }
}
