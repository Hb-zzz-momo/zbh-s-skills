{
  "tools": {
    "wps_excel_set_conditional_format": {
      "description": "设置条件格式。",
      "maps_to": "wps_excel_set_conditional_format",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "condition": {
            "description": "条件表达式，如 \"\u003e100\"、\"=0\"、\"between(1,10)\"",
            "type": "string"
          },
          "format": {
            "description": "格式描述，如 \"red_fill\"、\"bold\"、\"green_font\"",
            "type": "string"
          },
          "range": {
            "description": "要设置条件格式的范围，如 A1:D100",
            "type": "string"
          }
        },
        "required": [
          "range",
          "condition",
          "format"
        ],
        "type": "object"
      }
    }
  }
}
