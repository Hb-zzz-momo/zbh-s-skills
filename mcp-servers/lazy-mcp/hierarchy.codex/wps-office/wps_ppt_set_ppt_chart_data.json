{
  "tools": {
    "wps_ppt_set_ppt_chart_data": {
      "description": "更新幻灯片中已有图表的数据。\n\n使用场景：\n- \"更新第2页图表的数据\"\n- \"修改图表数据\"\n- \"替换图表中的数值\"",
      "maps_to": "wps_ppt_set_ppt_chart_data",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "chartIndex": {
            "description": "图表索引（从1开始）",
            "type": "number"
          },
          "data": {
            "description": "新的图表数据，包含 categories（类别数组）和 series（系列数组）",
            "type": "object"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "chartIndex",
          "data"
        ],
        "type": "object"
      }
    }
  }
}
