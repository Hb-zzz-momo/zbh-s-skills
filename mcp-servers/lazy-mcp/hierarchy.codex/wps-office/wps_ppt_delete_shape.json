      "maps_to": "wps_ppt_delete_shape",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "shapeIndex": {
            "description": "形状索引（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndex"
        ],
        "type": "object"
      }
    }
  }
}
