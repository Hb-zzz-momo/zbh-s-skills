{
  "tools": {
    "wps_excel_update_pivot_table": {
      "description": "更新已有透视表的配置，包括添加/移除字段、修改聚合方式等。\n\n使用场景：\n- \"给透视表加个筛选器\" -\u003e 使用addFilterFields\n- \"把销售额改成求平均\" -\u003e 使用updateValueFields\n- \"去掉月份这个列字段\" -\u003e 使用removeColumnFields\n- \"刷新透视表数据\" -\u003e 使用refresh=true\n\n支持的操作：\n- 添加/移除行字段\n- 添加/移除列字段\n- 添加/移除/更新值字段\n- 添加/移除筛选字段\n- 刷新数据",
      "maps_to": "wps_excel_update_pivot_table",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "addColumnFields": {
            "description": "要添加的列字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "addFilterFields": {
            "description": "要添加的筛选字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "addRowFields": {
            "description": "要添加的行字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "addValueFields": {
            "description": "要添加的值字段配置列表",
            "items": {
              "properties": {
                "aggregation": {
                  "description": "聚合方式",
                  "enum": [
                    "SUM",
                    "COUNT",
                    "AVERAGE",
                    "MAX",
                    "MIN"
                  ],
                  "type": "string"
                },
                "field": {
                  "description": "字段名",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "aggregation"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pivotTableCell": {
            "description": "透视表所在的任意单元格地址（可选）。如果提供了pivotTableName则忽略此参数",
            "type": "string"
          },
          "pivotTableName": {
            "description": "透视表名称。如果不确定名称，可以先用其他工具查看工作表内容",
            "type": "string"
          },
          "refresh": {
            "description": "是否刷新透视表数据（当源数据变化时使用）",
            "type": "boolean"
          },
          "removeColumnFields": {
            "description": "要移除的列字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeFilterFields": {
            "description": "要移除的筛选字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeRowFields": {
            "description": "要移除的行字段列名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeValueFields": {
            "description": "要移除的值字段名列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updateValueFields": {
            "description": "要更新的值字段配置（修改聚合方式）",
            "items": {
              "properties": {
                "aggregation": {
                  "description": "新的聚合方式",
                  "enum": [
                    "SUM",
                    "COUNT",
                    "AVERAGE",
                    "MAX",
                    "MIN"
                  ],
                  "type": "string"
                },
                "field": {
                  "description": "字段名",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "aggregation"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  }
}
