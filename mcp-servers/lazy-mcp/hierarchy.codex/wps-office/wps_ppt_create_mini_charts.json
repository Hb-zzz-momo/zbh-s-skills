{
  "tools": {
    "wps_ppt_create_mini_charts": {
      "description": "在幻灯片中创建迷你图表。\n\n基于数据数组生成紧凑的sparkline风格图表。\n\n使用场景：\n- \"创建一组迷你趋势图\"\n- \"添加sparkline图表\"\n- \"用小图表展示数据趋势\"",
      "maps_to": "wps_ppt_create_mini_charts",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "data": {
            "description": "数据数组，如 [{label:\"Q1\",values:[10,20,30]},{label:\"Q2\",values:[15,25,35]}]",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "data"
        ],
        "type": "object"
      }
    }
  }
}
