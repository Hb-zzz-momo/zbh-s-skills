{
  "tools": {
    "wps_excel_unmerge_cells": {
      "description": "拆分Excel中已合并的单元格，恢复为独立的单元格。",
      "maps_to": "wps_excel_unmerge_cells",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "range": {
            "description": "要拆分的合并单元格范围，如 A1:C3",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      }
    }
  }
}
