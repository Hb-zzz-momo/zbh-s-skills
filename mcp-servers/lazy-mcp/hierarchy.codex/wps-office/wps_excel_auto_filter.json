{
  "tools": {
    "wps_excel_auto_filter": {
      "description": "对Excel指定范围应用自动筛选。",
      "maps_to": "wps_excel_auto_filter",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "筛选列标识",
            "type": "string"
          },
          "criteria": {
            "description": "筛选条件",
            "type": "string"
          },
          "range": {
            "description": "筛选范围，如 A1:D100",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称",
            "type": "string"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      }
    }
  }
}
