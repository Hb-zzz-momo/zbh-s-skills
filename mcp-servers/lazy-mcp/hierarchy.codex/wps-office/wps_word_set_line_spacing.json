{
  "tools": {
    "wps_word_set_line_spacing": {
      "description": "设置段落行距。\n\n使用场景：\n- \"把行距设为1.5倍\"\n- \"设置第3段的行距为2倍\"\n- \"调整行距\"",
      "maps_to": "wps_word_set_line_spacing",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "lineSpacing": {
            "description": "行距值（如1.0、1.5、2.0等）",
            "type": "number"
          },
          "paragraphIndex": {
            "description": "段落索引（从0开始），不指定则应用于当前段落或全文",
            "type": "number"
          }
        },
        "required": [
          "lineSpacing"
        ],
        "type": "object"
      }
    }
  }
}
