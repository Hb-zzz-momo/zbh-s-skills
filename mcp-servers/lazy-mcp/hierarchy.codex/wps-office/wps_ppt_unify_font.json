{
  "tools": {
    "wps_ppt_unify_font": {
      "description": "统一演示文稿中所有幻灯片的字体。\n\n使用场景：\n- \"把所有页面的字体都改成微软雅黑\"\n- \"统一字体\"\n- \"换个字体\"\n\n常用字体推荐：\n- 微软雅黑：现代简洁，适合商务\n- 思源黑体：开源免费，适合各种场合\n- 黑体：传统正式\n- 宋体：适合正式文档",
      "maps_to": "wps_ppt_unify_font",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "font_name": {
            "description": "要统一使用的字体名称，如 \"微软雅黑\"、\"思源黑体\"",
            "type": "string"
          },
          "include_body": {
            "description": "是否包含正文，默认true",
            "type": "boolean"
          },
          "include_title": {
            "description": "是否包含标题，默认true",
            "type": "boolean"
          },
          "slide_index": {
            "description": "只处理指定页，不填则处理所有页",
            "type": "number"
          }
        },
        "required": [
          "font_name"
        ],
        "type": "object"
      }
    }
  }
}
