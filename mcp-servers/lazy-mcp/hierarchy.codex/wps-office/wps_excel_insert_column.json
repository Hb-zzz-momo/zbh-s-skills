{
  "tools": {
    "wps_excel_insert_column": {
      "description": "在指定位置插入列。可指定起始列号和插入列数。",
      "maps_to": "wps_excel_insert_column",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "要插入的列号（从1开始）",
            "type": "number"
          },
          "count": {
            "description": "要插入的列数，默认1",
            "type": "number"
          }
        },
        "required": [
          "column"
        ],
        "type": "object"
      }
    }
  }
}
