{
  "tools": {
    "wps_excel_auto_fill": {
      "description": "自动填充单元格区域。根据源区域的数据模式自动填充到目标区域。",
      "maps_to": "wps_excel_auto_fill",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "sourceRange": {
            "description": "源数据区域，如 \"A1:A5\"",
            "type": "string"
          },
          "targetRange": {
            "description": "目标填充区域，如 \"A1:A20\"",
            "type": "string"
          }
        },
        "required": [
          "sourceRange",
          "targetRange"
        ],
        "type": "object"
      }
    }
  }
}
