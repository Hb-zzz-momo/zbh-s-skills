{
  "tools": {
    "wps_ppt_set_background_color": {
      "description": "设置幻灯片背景为指定颜色。\n\n使用场景：\n- \"把第1页背景改成蓝色\"\n- \"设置背景颜色为 #FF5733\"\n- \"背景换成白色\"",
      "maps_to": "wps_ppt_set_background_color",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "color": {
            "description": "十六进制颜色值，如 \"#FF0000\"、\"#FFFFFF\"",
            "type": "string"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "color"
        ],
        "type": "object"
      }
    }
  }
}
