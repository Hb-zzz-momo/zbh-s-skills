{
  "tools": {
    "wps_excel_delete_row": {
      "description": "删除指定行。可指定起始行号和删除行数。",
      "maps_to": "wps_excel_delete_row",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "count": {
            "description": "要删除的行数，默认1",
            "type": "number"
          },
          "row": {
            "description": "要删除的起始行号（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "row"
        ],
        "type": "object"
      }
    }
  }
}
