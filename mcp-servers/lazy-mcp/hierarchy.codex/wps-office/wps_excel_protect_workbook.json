{
  "tools": {
    "wps_excel_protect_workbook": {
      "description": "保护或取消保护工作簿，防止结构被修改（如添加/删除工作表）。",
      "maps_to": "wps_excel_protect_workbook",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "password": {
            "description": "保护密码",
            "type": "string"
          },
          "protect": {
            "description": "是否保护，true为保护，false为取消保护",
            "type": "boolean"
          }
        },
        "required": [
          "password",
          "protect"
        ],
        "type": "object"
      }
    }
  }
}
