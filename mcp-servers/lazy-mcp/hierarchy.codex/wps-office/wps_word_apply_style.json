{
  "tools": {
    "wps_word_apply_style": {
      "description": "应用Word样式到当前选中区域或指定范围。\n\n支持的常用样式：\n- 标题1、标题2、标题3...（或 Heading 1, Heading 2...）\n- 正文、正文首行缩进\n- 引用、强调\n- 列表段落\n\n使用场景：\n- \"把这段设成标题1\"\n- \"应用正文样式\"",
      "maps_to": "wps_word_apply_style",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "range": {
            "description": "指定范围，不填则应用到当前选中区域",
            "properties": {
              "end": {
                "description": "结束位置（字符索引）",
                "type": "number"
              },
              "start": {
                "description": "起始位置（字符索引）",
                "type": "number"
              }
            },
            "type": "object"
          },
          "style_name": {
            "description": "样式名称，如 \"标题 1\"、\"正文\"、\"Heading 1\"",
            "type": "string"
          }
        },
        "required": [
          "style_name"
        ],
        "type": "object"
      }
    }
  }
}
