{
  "tools": {
    "wps_excel_move_sheet": {
      "description": "移动指定工作表到新的位置。",
      "maps_to": "wps_excel_move_sheet",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "要移动的工作表名称",
            "type": "string"
          },
          "position": {
            "description": "目标位置索引（从0开始）",
            "type": "number"
          }
        },
        "required": [
          "name",
          "position"
        ],
        "type": "object"
      }
    }
  }
}
