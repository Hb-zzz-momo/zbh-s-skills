{
  "tools": {
    "wps_cache_data": {
      "description": "缓存数据到MCP Server，用于跨应用数据传递。例如：从Excel读取数据后缓存，然后在PPT中使用。",
      "maps_to": "wps_cache_data",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "appType": {
            "description": "数据来源应用类型：et（表格）、wps（文字）、wpp（演示）",
            "enum": [
              "et",
              "wps",
              "wpp"
            ],
            "type": "string"
          },
          "data": {
            "description": "要缓存的数据（任意JSON对象）",
            "type": "object"
          },
          "key": {
            "description": "缓存键名，用于后续获取数据",
            "type": "string"
          }
        },
        "required": [
          "key",
          "data"
        ],
        "type": "object"
      }
    }
  }
}
