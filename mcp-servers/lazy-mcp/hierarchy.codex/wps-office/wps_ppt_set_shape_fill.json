{
  "tools": {
    "wps_ppt_set_shape_fill": {
      "description": "设置幻灯片中指定形状的填充颜色。\n\n使用场景：\n- \"把第1页的第2个形状填充为红色\"\n- \"修改形状背景色为#00FF00\"\n- \"设置形状的填充颜色\"",
      "maps_to": "wps_ppt_set_shape_fill",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "color": {
            "description": "填充颜色，十六进制如 #FF0000",
            "type": "string"
          },
          "shapeIndex": {
            "description": "形状索引（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndex",
          "color"
        ],
        "type": "object"
      }
    }
  }
}
