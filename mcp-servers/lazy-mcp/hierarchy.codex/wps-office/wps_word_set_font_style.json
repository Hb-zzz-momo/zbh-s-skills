{
  "tools": {
    "wps_word_set_font_style": {
      "description": "设置选中文字的字体样式属性",
      "maps_to": "wps_word_set_font_style",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "bold": {
            "description": "是否加粗",
            "type": "boolean"
          },
          "fontName": {
            "description": "字体名称",
            "type": "string"
          },
          "fontSize": {
            "description": "字号",
            "type": "number"
          },
          "italic": {
            "description": "是否斜体",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
