{
  "tools": {
    "wps_ppt_create_flow_chart": {
      "description": "在幻灯片中创建流程图。\n\nnodes 数组中每个节点包含：\n- id: 节点标识符\n- text: 节点显示文本\n- type: 节点类型（process/decision/start/end）\n\nconnections 数组中每个连接包含：\n- from: 起始节点id\n- to: 目标节点id\n- label: 连接线标签（可选）\n\n使用场景：\n- \"创建一个审批流程图\"\n- \"画一个工作流程图\"\n- \"制作决策流程图\"",
      "maps_to": "wps_ppt_create_flow_chart",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "connections": {
            "description": "节点之间的连接关系数组（可选）",
            "items": {
              "properties": {
                "from": {
                  "description": "起始节点id",
                  "type": "string"
                },
                "label": {
                  "description": "连接线标签",
                  "type": "string"
                },
                "to": {
                  "description": "目标节点id",
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nodes": {
            "description": "流程图节点数组",
            "items": {
              "properties": {
                "id": {
                  "description": "节点唯一标识",
                  "type": "string"
                },
                "text": {
                  "description": "节点显示文本",
                  "type": "string"
                },
                "type": {
                  "description": "节点类型: process/decision/start/end",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "nodes"
        ],
        "type": "object"
      }
    }
  }
}
