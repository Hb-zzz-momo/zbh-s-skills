{
  "tools": {
    "wps_word_insert_header": {
      "description": "设置页眉内容。\n\n使用场景：\n- \"给文档加个页眉\"\n- \"设置页眉为公司名称\"\n- \"修改第2节的页眉\"",
      "maps_to": "wps_word_insert_header",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "section": {
            "default": 1,
            "description": "节编号（从1开始），默认1",
            "type": "number"
          },
          "text": {
            "description": "页眉文本内容",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      }
    }
  }
}
