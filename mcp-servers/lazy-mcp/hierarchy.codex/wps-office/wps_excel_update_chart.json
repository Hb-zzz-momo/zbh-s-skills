{
  "tools": {
    "wps_excel_update_chart": {
      "description": "更新Excel图表的属性，包括标题、颜色、图例、数据标签等。\n\n使用场景：\n- \"把图表标题改成销售报表\" -\u003e 更新 title\n- \"隐藏图例\" -\u003e 设置 show_legend: false\n- \"显示数据标签\" -\u003e 设置 show_data_labels: true\n- \"改变图表类型为折线图\" -\u003e 设置 chart_type: line\n\n注意：需要先通过 wps_excel_create_chart 创建图表，或者指定已存在图表的名称/索引",
      "maps_to": "wps_excel_update_chart",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "chart_index": {
            "description": "图表索引（从1开始），与chart_name二选一",
            "type": "number"
          },
          "chart_name": {
            "description": "图表名称，与chart_index二选一",
            "type": "string"
          },
          "chart_type": {
            "description": "更改图表类型",
            "enum": [
              "column_clustered",
              "column_stacked",
              "bar_clustered",
              "line",
              "line_markers",
              "pie",
              "doughnut",
              "scatter",
              "area",
              "radar"
            ],
            "type": "string"
          },
          "colors": {
            "description": "系列颜色数组，如 [\"#FF0000\", \"#00FF00\", \"#0000FF\"]",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "data_range": {
            "description": "更改数据源范围",
            "type": "string"
          },
          "legend_position": {
            "description": "图例位置：bottom（下）、top（上）、left（左）、right（右）",
            "enum": [
              "bottom",
              "top",
              "left",
              "right"
            ],
            "type": "string"
          },
          "sheet": {
            "description": "图表所在的工作表名称",
            "type": "string"
          },
          "show_data_labels": {
            "description": "是否显示数据标签",
            "type": "boolean"
          },
          "show_legend": {
            "description": "是否显示图例",
            "type": "boolean"
          },
          "title": {
            "description": "新的图表标题",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
