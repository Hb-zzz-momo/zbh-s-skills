{
  "tools": {
    "wps_ppt_add_chart": {
      "description": "在幻灯片中插入图表。\n\n支持的图表类型：\n- bar: 柱形图\n- line: 折线图\n- pie: 饼图\n- scatter: 散点图\n- area: 面积图\n- doughnut: 圆环图\n\n使用场景：\n- \"在第1页插入一个柱形图\"\n- \"添加饼图展示数据\"\n- \"插入折线图显示趋势\"",
      "maps_to": "wps_ppt_add_chart",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "chartType": {
            "description": "图表类型，如 bar, line, pie, scatter, area, doughnut",
            "type": "string"
          },
          "data": {
            "description": "图表数据数组，每项包含标签和数值",
            "items": {
              "properties": {
                "label": {
                  "description": "数据标签",
                  "type": "string"
                },
                "value": {
                  "description": "数据值",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "chartType",
          "data"
        ],
        "type": "object"
      }
    }
  }
}
