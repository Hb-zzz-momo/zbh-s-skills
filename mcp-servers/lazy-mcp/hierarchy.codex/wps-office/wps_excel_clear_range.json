{
  "tools": {
    "wps_excel_clear_range": {
      "description": "清除指定范围的内容、格式或全部。",
      "maps_to": "wps_excel_clear_range",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "range": {
            "description": "范围地址，如 A1:C10",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前工作表",
            "type": "string"
          },
          "type": {
            "description": "清除类型：all（全部）、contents（仅内容）、formats（仅格式）",
            "enum": [
              "all",
              "contents",
              "formats"
            ],
            "type": "string"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      }
    }
  }
}
