{
  "tools": {
    "wps_word_set_page_setup": {
      "description": "设置文档页面布局，包括页面方向和边距。\n\n使用场景：\n- \"把页面改成横向\"\n- \"设置上下边距为2厘米\"\n- \"调整页面为A4横向，边距2cm\"",
      "maps_to": "wps_word_set_page_setup",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "marginBottom": {
            "description": "下边距（磅值）",
            "type": "number"
          },
          "marginLeft": {
            "description": "左边距（磅值）",
            "type": "number"
          },
          "marginRight": {
            "description": "右边距（磅值）",
            "type": "number"
          },
          "marginTop": {
            "description": "上边距（磅值）",
            "type": "number"
          },
          "orientation": {
            "description": "页面方向: \"portrait\"(纵向) 或 \"landscape\"(横向)",
            "enum": [
              "portrait",
              "landscape"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
