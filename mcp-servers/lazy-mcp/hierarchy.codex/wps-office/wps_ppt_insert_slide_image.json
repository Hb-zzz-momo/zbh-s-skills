{
  "tools": {
    "wps_ppt_insert_slide_image": {
      "description": "在幻灯片中插入图片。\n\n使用场景：\n- \"在第1页插入一张图片\"\n- \"添加图片到幻灯片\"\n- \"把这个图片放到PPT里\"",
      "maps_to": "wps_ppt_insert_slide_image",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "imagePath": {
            "description": "图片文件的完整路径",
            "type": "string"
          },
          "left": {
            "description": "左边距（像素），默认100",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          },
          "top": {
            "description": "上边距（像素），默认100",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "imagePath"
        ],
        "type": "object"
      }
    }
  }
}
