{
  "tools": {
    "wps_excel_copy_sheet": {
      "description": "复制当前工作簿中的指定工作表。可指定新名称和插入位置。",
      "maps_to": "wps_excel_copy_sheet",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "要复制的工作表名称",
            "type": "string"
          },
          "newName": {
            "description": "复制后的工作表名称，不填则自动生成",
            "type": "string"
          },
          "position": {
            "description": "插入位置索引（从0开始），不填则添加到末尾",
            "type": "number"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    }
  }
}
