{
  "tools": {
    "wps_ppt_set_table_row_style": {
      "description": "设置PPT表格中指定行的样式。\n\n支持的样式属性（通过style对象传入）：\n- backgroundColor: 行背景色\n- fontName: 字体名称\n- fontSize: 字体大小（磅）\n- fontColor: 字体颜色\n- bold: 是否加粗（boolean）\n- italic: 是否斜体（boolean）\n- alignment: 文本对齐方式（left/center/right）\n- height: 行高（磅）\n\n使用场景：\n- \"把表头行设为蓝色背景白色字\"\n- \"加粗第一行\"\n- \"设置表格行高\"",
      "maps_to": "wps_ppt_set_table_row_style",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "row": {
            "description": "行号（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          },
          "style": {
            "description": "样式配置对象，包含backgroundColor、fontName、fontSize、fontColor、bold、italic、alignment、height等属性",
            "type": "object"
          },
          "tableIndex": {
            "description": "表格索引（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "tableIndex",
          "row",
          "style"
        ],
        "type": "object"
      }
    }
  }
}
