{
  "tools": {
    "wps_get_cell_value": {
      "description": "读取指定单元格的值",
      "maps_to": "wps_get_cell_value",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "col": {
            "description": "列号（从1开始）",
            "type": "number"
          },
          "row": {
            "description": "行号（从1开始）",
            "type": "number"
          },
          "sheet": {
            "description": "工作表名称或索引",
            "type": "string"
          }
        },
        "required": [
