{
  "tools": {
    "wps_excel_group_rows": {
      "description": "对Excel中指定范围的行进行分组，便于折叠/展开管理。",
      "maps_to": "wps_excel_group_rows",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "endRow": {
            "description": "结束行号（从1开始）",
            "type": "number"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          },
          "startRow": {
            "description": "起始行号（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "startRow",
          "endRow"
        ],
        "type": "object"
      }
    }
  }
}
