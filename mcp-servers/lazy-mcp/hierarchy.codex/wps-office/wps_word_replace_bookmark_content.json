{
  "tools": {
    "wps_word_replace_bookmark_content": {
      "description": "替换Word文档中书签的内容。通过书签名定位，替换书签范围内的文本，保持原有格式。\n\n使用场景：\n- \"把书签'project_name'的内容改为'XX项目'\"\n- 模板文档使用书签标记填写位置时使用\n\n注意：替换后书签会自动重建，不会丢失。",
      "maps_to": "wps_word_replace_bookmark_content",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "书签名称",
            "type": "string"
          },
          "text": {
            "description": "要替换为的文本内容",
            "type": "string"
          }
        },
        "required": [
          "name",
          "text"
        ],
        "type": "object"
      }
    }
  }
}
