{
  "tools": {
    "wps_excel_subtotal": {
      "description": "创建分类汇总。",
      "maps_to": "wps_excel_subtotal",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "columns": {
            "description": "要汇总的列标识列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "function": {
            "description": "汇总函数",
            "enum": [
              "sum",
              "count",
              "average",
              "max",
              "min"
            ],
            "type": "string"
          },
          "groupBy": {
            "description": "分组列标识",
            "type": "string"
          },
          "range": {
            "description": "数据范围，如 A1:D100",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称",
            "type": "string"
          }
        },
        "required": [
          "range",
          "groupBy",
          "function",
          "columns"
        ],
        "type": "object"
      }
    }
  }
}
