{
  "tools": {
    "wps_excel_insert_row": {
      "description": "在Excel中插入行。",
      "maps_to": "wps_excel_insert_row",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "count": {
            "description": "插入行数，默认1",
            "type": "number"
          },
          "row": {
            "description": "在第几行前插入（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "row"
        ],
        "type": "object"
      }
    }
  }
}
