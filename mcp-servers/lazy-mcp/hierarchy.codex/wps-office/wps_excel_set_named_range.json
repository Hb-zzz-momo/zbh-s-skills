{
  "tools": {
    "wps_excel_set_named_range": {
      "description": "设置命名范围。为指定单元格区域创建或更新命名范围。",
      "maps_to": "wps_excel_set_named_range",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "命名范围的名称",
            "type": "string"
          },
          "range": {
            "description": "单元格区域，如 \"A1:D10\"",
            "type": "string"
          }
        },
        "required": [
          "name",
          "range"
        ],
        "type": "object"
      }
    }
  }
}
