{
  "tools": {
    "wps_excel_merge_cells": {
      "description": "合并Excel指定范围的单元格。合并后保留左上角单元格的值。",
      "maps_to": "wps_excel_merge_cells",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "range": {
            "description": "要合并的范围，如 A1:C3",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      }
    }
  }
}
