{
  "tools": {
    "wps_excel_get_formula": {
      "description": "获取Excel指定单元格的公式。",
      "maps_to": "wps_excel_get_formula",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "cell": {
            "description": "单元格地址，如 A1、B2",
            "type": "string"
          },
          "sheet": {
            "description": "工作表名称",
            "type": "string"
          }
        },
        "required": [
          "sheet",
          "cell"
        ],
        "type": "object"
      }
    }
  }
}
