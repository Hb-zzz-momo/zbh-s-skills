{
  "tools": {
    "wps_ppt_set_3d_rotation": {
      "description": "设置幻灯片中形状的3D旋转效果。\n\n通过调整X/Y/Z轴旋转角度实现3D透视效果。\n\n使用场景：\n- \"给形状添加3D旋转效果\"\n- \"设置3D透视角度\"\n- \"让形状有立体感\"",
      "maps_to": "wps_ppt_set_3d_rotation",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "rotation": {
            "description": "旋转参数对象，如 {rotX:30,rotY:45,rotZ:0,perspective:50}",
            "type": "object"
          },
          "shapeIndex": {
            "description": "形状索引（从1开始）",
            "type": "number"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndex",
          "rotation"
        ],
        "type": "object"
      }
    }
  }
}
