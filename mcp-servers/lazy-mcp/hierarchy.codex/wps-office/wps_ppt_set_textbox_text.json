{
  "tools": {
    "wps_ppt_set_textbox_text": {
      "description": "设置指定文本框的文本内容。",
      "maps_to": "wps_ppt_set_textbox_text",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "slideIndex": {
            "description": "幻灯片索引（从1开始）",
            "type": "number"
          },
          "text": {
            "description": "文本内容",
            "type": "string"
          },
          "textboxIndex": {
            "description": "文本框索引",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "textboxIndex",
          "text"
        ],
        "type": "object"
      }
    }
  }
}
