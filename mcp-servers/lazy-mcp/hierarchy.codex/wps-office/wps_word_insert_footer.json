{
  "tools": {
    "wps_word_insert_footer": {
      "description": "设置页脚内容。\n\n使用场景：\n- \"给文档加个页脚\"\n- \"设置页脚为页码\"\n- \"修改第1节的页脚\"",
      "maps_to": "wps_word_insert_footer",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "section": {
            "default": 1,
            "description": "节编号（从1开始），默认1",
            "type": "number"
          },
          "text": {
            "description": "页脚文本内容",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      }
    }
  }
}
