{
  "tools": {
    "wps_ppt_add_page_indicator": {
      "description": "为演示文稿添加页码指示器。\n\n支持的位置：\n- bottom-right: 右下角（默认）\n- bottom-center: 底部居中\n- bottom-left: 左下角\n\n使用场景：\n- \"给PPT加上页码\"\n- \"在右下角添加页码指示\"\n- \"添加页面进度指示器\"",
      "maps_to": "wps_ppt_add_page_indicator",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "position": {
            "description": "页码位置",
            "enum": [
              "bottom-right",
              "bottom-center",
              "bottom-left"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
