{
  "tools": {
    "wps_excel_insert_rows": {
      "description": "在Excel中指定位置插入一行或多行。",
      "maps_to": "wps_excel_insert_rows",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "count": {
            "description": "插入行数，默认1",
            "type": "number"
          },
          "row": {
            "description": "在第几行前插入（从1开始）",
            "type": "number"
          },
          "sheet": {
            "description": "工作表名称，不填则使用当前活动工作表",
            "type": "string"
          }
        },
        "required": [
          "row"
        ],
        "type": "object"
      }
    }
  }
}
