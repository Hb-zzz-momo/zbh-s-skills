{
  "tools": {
    "wps_word_insert_table": {
      "description": "在Word文档光标位置插入表格",
      "maps_to": "wps_word_insert_table",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "cols": {
            "description": "表格列数",
            "type": "number"
          },
          "rows": {
            "description": "表格行数",
            "type": "number"
          }
        },
        "required": [
          "rows",
          "cols"
        ],
        "type": "object"
      }
    }
  }
}
