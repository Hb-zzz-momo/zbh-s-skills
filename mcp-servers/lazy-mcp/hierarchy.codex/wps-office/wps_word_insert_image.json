{
  "tools": {
    "wps_word_insert_image": {
      "description": "在Word文档中插入图片。\n\n使用场景：\n- \"在文档中插入一张图片\"\n- \"把这个截图放到文档里\"\n- \"在光标位置插入logo\"",
      "maps_to": "wps_word_insert_image",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "height": {
            "description": "图片高度（磅），可选",
            "type": "number"
          },
          "imagePath": {
            "description": "图片文件路径",
            "type": "string"
          },
          "width": {
            "description": "图片宽度（磅），可选",
            "type": "number"
          }
        },
        "required": [
          "imagePath"
        ],
        "type": "object"
      }
    }
  }
}
