{
  "tools": {
    "wps_ppt_align_shapes": {
      "description": "对齐幻灯片中的多个形状。\n\n支持的对齐方式：\n- left: 左对齐\n- center: 水平居中\n- right: 右对齐\n- top: 顶部对齐\n- middle: 垂直居中\n- bottom: 底部对齐\n\n使用场景：\n- \"把这几个形状左对齐\"\n- \"让第1、3、5个形状垂直居中\"",
      "maps_to": "wps_ppt_align_shapes",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "alignment": {
            "description": "对齐方式",
            "enum": [
              "left",
              "center",
              "right",
              "top",
              "middle",
              "bottom"
            ],
            "type": "string"
          },
          "shapeIndices": {
            "description": "要对齐的形状索引数组（从1开始）",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "slideIndex": {
            "description": "幻灯片页码（从1开始）",
            "type": "number"
          }
        },
        "required": [
          "slideIndex",
          "shapeIndices",
          "alignment"
        ],
        "type": "object"
      }
    }
  }
}
