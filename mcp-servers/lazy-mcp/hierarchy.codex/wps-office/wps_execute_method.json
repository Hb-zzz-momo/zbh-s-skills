{
  "tools": {
    "wps_execute_method": {
      "description": "执行自定义WPS API方法",
      "maps_to": "wps_execute_method",
      "server": "wps-office",
      "inputSchema": {
        "properties": {
          "appType": {
            "description": "应用类型：wps（文字）、et（表格）、wpp（演示）",
            "enum": [
              "wps",
              "et",
              "wpp"
            ],
            "type": "string"
          },
          "method": {
            "description": "API方法名",
            "type": "string"
          },
          "params": {
            "description": "方法参数",
            "type": "object"
          }
        },
        "required": [
          "method"
        ],
        "type": "object"
      }
    }
  }
}
